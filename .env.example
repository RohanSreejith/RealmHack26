# Hack-Eye Environment Configuration
# Copy this file to .env and configure keys

# AI Intelligence Layer
ADAPTION_API_KEY=
ADAPTION_API_URL=https://api.adaption.ai/v1/chat/completions

# Regulatory Safety Knowledge
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1

# Operational Automation
N8N_WEBHOOK_URL=
N8N_API_KEY=

# Cloud Platform & Database (PostgreSQL on Render, SQLite on Edge)
DATABASE_URL=sqlite:///hackeye_edge.db
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Edge Safety Thresholds
WARNING_DISTANCE_METERS=6.0
CRITICAL_DISTANCE_METERS=3.0
WARNING_TTC_SECONDS=4.0
CRITICAL_TTC_SECONDS=2.0
